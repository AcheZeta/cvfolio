---
import Icon from '@/components/ui/Icon.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const { name } = DEFAULT_CONFIGURATION.author;

const pathname = Astro.url.pathname;
const isHomePage   = pathname === '/';
const isAboutPage  = pathname.startsWith('/about');
const isPortafolioPage = pathname.startsWith('/portafolio');

type NavItem = { href: string; label: string; active: boolean };
const navItems: NavItem[] = [
  { href: '/portafolio', label: 'Portafolio', active: isPortafolioPage },
  { href: '/about',      label: 'Sobre mí',   active: isAboutPage },
];
---

<header
  class:list={[
    'site-header',
    'site-header--dark',
  ]}
  aria-label="Navegación principal"
>
  <div class="header-inner">

    <!-- Logo / nombre -->
    <a href="/" class="header-logo" aria-label={`Inicio — ${name}`}>
      {name}
    </a>

    <!-- Menú Hamburguesa -->
    <button class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
    </button>

    <!-- Contenedor de Nav + CTA -->
    <div class="header-actions">
      <!-- Nav links centrados -->
      <nav class="header-nav">
        <ul role="list">
          {navItems.map(({ href, label, active }) => (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={['nav-link', active && 'nav-link--active']}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- CTA Hablemos -->
      <a href="/#contacto" class="header-cta">
        Hablemos <Icon name="arrow-right" size={14} class="header-cta-arrow" />
      </a>
    </div>

  </div>
</header>

<script>
  let lastScroll = 0;
  const header = document.querySelector('.site-header');
  const toggleBtn = document.querySelector('.mobile-toggle');
  const headerActions = document.querySelector('.header-actions');

  // Lógica de menú móvil
  if (toggleBtn && headerActions) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      headerActions.classList.toggle('is-open');
    });

    // Cerrar menú al hacer click en un enlace
    const links = headerActions.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        headerActions.classList.remove('is-open');
      });
    });
  }

  // Ocultar header en scroll hacia abajo
  window.addEventListener('scroll', () => {
    if (!header) return;
    const currentScroll = window.scrollY;

    // Si el menú está abierto, no ocultar el header
    if (headerActions?.classList.contains('is-open')) return;

    if (currentScroll > lastScroll && currentScroll > 100) {
      header.classList.add('site-header--hidden');
    } else {
      header.classList.remove('site-header--hidden');
    }

    lastScroll = currentScroll <= 0 ? 0 : currentScroll;
  }, { passive: true });
</script>
