---
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
const { name } = DEFAULT_CONFIGURATION.author;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- Izquierda: nombre -->
    <span class="footer-name">{name}</span>

    <!-- Centro: copyright -->
    <p class="footer-copy">
      &copy; {currentYear} {name}
    </p>

    <!-- Derecha: disponibilidad -->
    <div class="footer-availability">
      <span class="footer-dot" aria-hidden="true">
        <span class="footer-dot-pulse"></span>
        <span class="footer-dot-solid"></span>
      </span>
      <span>Disponible</span>
    </div>

  </div>
</footer>
