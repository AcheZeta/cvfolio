---
import Container from '@/components/Container.astro';

const currentYear = new Date().getFullYear();
---

<Container as="footer" class="pt-24 pb-8">
  <div class="flex flex-col items-center gap-3">
    <!-- Availability indicator -->
    <div class="flex items-center gap-2 text-sm text-[var(--color-muted-foreground)]">
      <span class="relative flex h-2.5 w-2.5">
        <span
          class="pulse-dot absolute inline-flex h-full w-full rounded-full opacity-75"
          style="background-color: #4ade80;"
        ></span>
        <span
          class="relative inline-flex rounded-full h-2.5 w-2.5"
          style="background-color: #22c55e;"
        ></span>
      </span>
      <span>Disponible para proyectos y colaboraciones</span>
    </div>

    <p class="text-center text-[var(--color-muted-foreground)] text-xs">
      &copy; {currentYear} Hame Elizalde &mdash; Hecho con cariño en México 🌮
    </p>
  </div>
</Container>
