---
import { getCollection } from 'astro:content';
import MasonryCard from '@/components/ui/MasonryCard.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

interface Props {
  limit?: number;
  filter?: 'proyecto' | 'blog' | 'charla' | 'foto';
  hideHeader?: boolean;
  showContactCard?: boolean;
}

const { limit, filter, hideHeader = false, showContactCard = false } = Astro.props;

// Fetch all collections
const projects = await getCollection('projects');
const posts    = await getCollection('posts');
const talks    = await getCollection('talks');
const photos   = await getCollection('photos');

type FeedItem = {
  title: string;
  href: string;
  image?: any;
  date: Date;
  description?: string;
  category: 'proyecto' | 'blog' | 'charla' | 'foto';
  tags?: string[];
};

// Helper to clean tags
const processTags = (tags: string[] = []) => {
  return tags.filter(Boolean).map(tag => tag.trim());
};

const projectItems: FeedItem[] = projects.map((p) => ({
  title: p.data.title,
  href: `/projects/${p.id}`,
  image: p.data.image,
  date: p.data.date,
  description: p.data.description,
  category: 'proyecto',
  tags: processTags(p.data.tags),
}));

const postItems: FeedItem[] = posts.map((p) => ({
  title: p.data.title,
  href: `/writing/${p.id}`,
  image: p.data.image,
  date: p.data.date,
  description: p.data.seo?.description,
  category: 'blog',
  tags: processTags(p.data.tags),
}));

const talkItems: FeedItem[] = talks.map((t) => ({
  title: t.data.title,
  href: t.data.url || `/talks/${t.id}`,
  image: t.data.image,
  date: new Date(t.data.year, 0, 1),
  description: `${t.data.event} · ${t.data.location}`,
  category: 'charla',
  tags: processTags(t.data.tags),
}));

const photoItems: FeedItem[] = photos.map((p) => ({
  title: p.data.title,
  href: `/photos/${p.id}`,
  image: p.data.cover,
  date: p.data.date,
  description: p.data.description ?? p.data.location,
  category: 'foto',
  tags: processTags(p.data.tags),
}));

// Mix and sort by date descending
const feedItems: FeedItem[] = [
  ...projectItems,
  ...postItems,
  ...talkItems,
  ...photoItems,
].sort((a, b) => b.date.getTime() - a.date.getTime());

// Filter items if needed (server-side initial state)
const filteredItems = filter 
  ? feedItems.filter(item => item.category === filter)
  : feedItems;

const displayItems = limit ? filteredItems.slice(0, limit) : filteredItems;

// Extract unique tags for the filter bar (case-insensitive deduplication)
const uniqueTagsMap = new Map<string, string>();
displayItems.flatMap(item => item.tags || []).forEach(tag => {
  const lowerTag = tag.toLowerCase();
  if (!uniqueTagsMap.has(lowerTag)) {
    uniqueTagsMap.set(lowerTag, tag);
  }
});
const availableTags = Array.from(uniqueTagsMap.values()).sort().slice(0, 12);

// Read contact email from CMS
const linksRaw = await getCollection('links');
const emailLink = linksRaw.find((l) => l.id === 'email');
const emailHref = emailLink?.data.url ?? `mailto:${DEFAULT_CONFIGURATION.author.email || 'hame.elizalde@gmail.com'}`;
---

<section class="py-6">
  {
    !hideHeader && (
      <div class="flex flex-col gap-2 mb-8 reveal">
        <span
          class="text-xs font-medium uppercase tracking-widest"
          style="color: var(--color-lavender);"
        >
          Proyectos, Charlas & Blog
        </span>
        <div class="flex items-end justify-between gap-4 flex-wrap">
          <h2 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
            Lo que he creado
          </h2>
          <a
            href="/portafolio"
            class="text-sm font-medium hover:text-[var(--color-lavender)] transition-colors"
            style="color: var(--color-dark-text); opacity: 0.7;"
          >
            Ver todo →
          </a>
        </div>
      </div>
    )
  }

  <!-- Filter Bar -->
  <div class="feed-filters mb-8 reveal" role="group" aria-label="Filtrar contenido">
    <button 
      class="feed-filter feed-filter--active"
      data-filter="all"
      type="button"
    >
      Todos
    </button>
    
    {!filter && (
      <>
        <button class="feed-filter" data-filter="proyecto" type="button">
          Proyectos
        </button>
        <button class="feed-filter" data-filter="blog" type="button">
          Blog
        </button>
        <button class="feed-filter" data-filter="charla" type="button">
          Charlas
        <button class="feed-filter" data-filter="foto" type="button">
          Fotografía
        </button>
        </button>
      </>
    )}

    {availableTags.length > 0 && (
      <div style="width: 2px; height: 20px; background-color: var(--color-dark); opacity: 0.15; align-self: center;" class="hidden sm:block mx-1"></div>
    )}
  </div>

  <!-- Masonry grid via CSS columns (defined in global.css) -->
  <div id="masonry-container" class="masonry-grid reveal reveal-delay-2">
    {
      displayItems.map((item) => (
        <MasonryCard
          title={item.title}
          href={item.href}
          image={item.image}
          date={item.date}
          description={item.description}
          category={item.category}
          tags={item.tags}
        />
      ))
    }

    {showContactCard && (
      <div class="masonry-card feed-item--contact" data-category="contact" style="break-inside: avoid; margin-bottom: 1rem;">
        <div
          class="post-card post-card--contact"
          style="background: var(--color-bubblegum); border: 2px solid var(--color-dark);"
        >
          <!-- Etiqueta flotante izquierda -->
          <span
            class="post-card__label post-card__label--left"
            style="background: var(--color-dark); color: var(--color-bg); border: 2px solid var(--color-dark);"
            aria-hidden="true"
          >
            Trabajemos juntas ✦
          </span>

          <div class="post-card__body">
            <h3
              class="post-card__title"
              style="color: var(--color-dark); font-size: 1.4rem;"
            >
              ¿Tienes un proyecto en mente?
            </h3>
            <p class="post-card__desc" style="color: rgba(26,15,46,0.7);">
              Me encantará escucharte. Mándame un mensaje y hablamos.
            </p>
          </div>

          <div
            class="post-card__footer"
            style="border-top: 1.5px solid rgba(26,15,46,0.15);"
          >
            <div></div>
            <a
              href={emailHref}
              class="contact-card-btn"
              aria-label="Enviar email a Hame Elizalde"
            >
              Envíame un mensaje
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7V17"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll('.feed-filter');
    const container = document.getElementById('masonry-container');
    if (!buttons.length || !container) return;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;
        
        // Update active classes
        buttons.forEach(b => {
          b.classList.remove('feed-filter--active');
        });
        btn.classList.add('feed-filter--active');

        const applyFilter = () => {
          const cards = container.querySelectorAll<HTMLElement>('.masonry-card');
          cards.forEach(card => {
            const cardCategory = card.getAttribute('data-category');
            if (cardCategory === 'contact') {
              // Contact card is always visible
              card.style.display = 'block';
              return;
            }
            
            const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
            const isMatch = filter === 'all' || 
                            cardCategory === filter || 
                            cardTags.some((t: string) => t.toLowerCase() === filter.toLowerCase());

            if (isMatch) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        };

        // Use View Transitions API if available
        if ('startViewTransition' in document) {
          // @ts-ignore
          document.startViewTransition(() => applyFilter());
        } else {
          applyFilter();
        }
      });
    });
  }

  // Run on initial load
  initFilters();

  // Run on view transitions
  document.addEventListener('astro:after-swap', initFilters);
</script>
