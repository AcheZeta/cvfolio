---
/**
 * ProjectsSection.astro
 * Sección de proyectos seleccionados. Fondo #1C0F25, header con tecla SVG,
 * bento grid de ProjectCards.
 */
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;

const posts = await getCollection('posts');

// Ordenar por fecha desc
const sorted = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
---

<section class="projects-section" aria-label="Proyectos seleccionados">

  <!-- ─── Header ─────────────────────────────────── -->
  <div class="projects-header">
    <p class="projects-label">BLOG</p>
    <h2 class="projects-heading">
      <span class="projects-heading-icon" aria-hidden="true">
        <Icon name="tecla" size={52} />
      </span>
      Últimos artículos
    </h2>
  </div>

  <!-- ─── Grid bento ─────────────────────────────── -->
  <div class="projects-grid">
    {sorted.map((p, i) => (
      <ProjectCard
        title={p.data.title}
        href={`/writing/${p.id}`}
        description={p.data.seo?.description}
        tags={['Blog']}
        accentIndex={i}
      />
    ))}
  </div>

  <!-- ─── Ver todos ───────────────────────────────── -->
  <div class="projects-footer">
    <a href="/portafolio" class="projects-more">
      Ver todos los artículos →
    </a>
  </div>

</section>
