---
/**
 * FeedSection.astro
 * Feed principal estilo Tumblr: proyectos + posts mezclados en orden cronológico inverso.
 * Incluye filtros de categoría (pills) y card de contacto al final.
 * Los colores de cada card se asignan dinámicamente con cardColors.ts.
 */
import { getCollection } from 'astro:content';
import PostCard, { type CardVariant } from '@/components/ui/PostCard.astro';
import { getCardColor } from '@/utils/cardColors';

// Recopilar proyectos y posts
const projects = await getCollection('projects');
const posts    = await getCollection('posts');

// Mapa de color hex → nombre de variante de PostCard
const hexToVariant: Record<string, CardVariant> = {
  '#C4BAED': 'lavender',
  '#FFD97D': 'butter',
  '#A8DCC8': 'sage',
  '#1A0F2E': 'dark',
  '#F7A3C0': 'bubblegum',
  '#FF8C61': 'lavender', // tangerine → fallback a lavender variant visually
};

function toVariant(hex: string): CardVariant {
  return hexToVariant[hex.toUpperCase()] ?? 'lavender';
}

// Normalizar a un tipo común para el feed
type FeedItem = {
  id: string;
  kind: 'project' | 'blog';
  title: string;
  href: string;
  description?: string;
  tags?: string[];
  role?: string;
  date: Date;
  variant: CardVariant;
  bgHex: string;
  floatingLabel?: string;
};

// Asignar colores dinámicos a proyectos
let prevColor = '';
const projectItems: FeedItem[] = projects.map((p) => {
  const bgHex = getCardColor(p.data.tags ?? [], p.id, prevColor);
  prevColor = bgHex;
  return {
    id:          `project-${p.id}`,
    kind:        'project' as const,
    title:       p.data.title,
    href:        `/projects/${p.id}`,
    description: p.data.description,
    tags:        p.data.tags,
    role:        p.data.role,
    date:        p.data.date,
    variant:     toVariant(bgHex),
    bgHex,
    floatingLabel: p.data.role ?? 'Proyecto',
  };
});

const postItems: FeedItem[] = posts.map((p) => {
  const bgHex = getCardColor(p.data.tags ?? [], p.id, prevColor);
  prevColor = bgHex;
  return {
    id:          `post-${p.id}`,
    kind:        'blog' as const,
    title:       p.data.title,
    href:        `/writing/${p.id}`,
    description: p.data.seo?.description,
    tags:        p.data.tags,
    date:        p.data.date,
    variant:     toVariant(bgHex),
    bgHex,
  };
});

// Mezclar y ordenar cronológicamente (más reciente primero)
const feed: FeedItem[] = [...projectItems, ...postItems].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);

// Categorías para los filtros
const filterCategories = [
  { id: 'all',       label: 'Todo' },
  { id: 'project',   label: 'Proyectos' },
  { id: 'blog',      label: 'Blog' },
  { id: 'ux',        label: 'UX' },
  { id: 'frontend',  label: 'Frontend' },
];
---

<!-- ─── Filtros de categoría ─────────────────────── -->
<div class="feed-filters" role="group" aria-label="Filtrar contenido">
  {filterCategories.map(({ id, label }) => (
    <button
      class:list={['feed-filter', id === 'all' && 'feed-filter--active']}
      data-filter={id}
      type="button"
    >
      {label}
    </button>
  ))}
</div>

<!-- ─── Feed de cards ─────────────────────────────── -->
<div class="feed-grid" id="feed-grid" role="feed" aria-label="Feed de proyectos y artículos">
  {feed.map((item) => (
    <div class="feed-item" data-kind={item.kind} data-tags={(item.tags ?? []).join(',').toLowerCase()}>
      <PostCard
        title={item.title}
        href={item.href}
        description={item.description}
        tags={item.tags}
        role={item.role}
        date={item.date}
        variant={item.variant}
        kind={item.kind}
        floatingLabel={item.floatingLabel}
      />
    </div>
  ))}

  <!-- ─── Card de contacto (última del feed) ─────── -->
  <div class="feed-item feed-item--contact" data-kind="contact">
    <div
      class="post-card post-card--contact"
      style="background: var(--color-bubblegum); border: 2px solid var(--color-dark);"
    >
      <!-- Etiqueta flotante izquierda -->
      <span
        class="post-card__label post-card__label--left"
        style="background: var(--color-dark); color: var(--color-bg); border: 2px solid var(--color-dark);"
        aria-hidden="true"
      >
        Trabajemos juntas ✦
      </span>

      <div class="post-card__body">
        <h3 class="post-card__title" style="color: var(--color-dark); font-size: 1.4rem;">
          ¿Tienes un proyecto en mente?
        </h3>
        <p class="post-card__desc" style="color: rgba(26,15,46,0.7);">
          Me encantará escucharte. Mándame un mensaje y hablamos.
        </p>
      </div>

      <div class="post-card__footer" style="border-top: 1.5px solid rgba(26,15,46,0.15);">
        <div></div>
        <a
          href="mailto:hame.elizalde@gmail.com"
          class="contact-card-btn"
          aria-label="Enviar email a Hame Elizalde"
        >
          Envíame un mensaje
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ─── Script de filtros ────────────────────────── -->
<script>
  const filters  = document.querySelectorAll<HTMLButtonElement>('.feed-filter');
  const feedGrid = document.getElementById('feed-grid');

  if (feedGrid) {
    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Actualizar estado activo
        filters.forEach((b) => b.classList.remove('feed-filter--active'));
        btn.classList.add('feed-filter--active');

        const filter = btn.dataset.filter ?? 'all';
        const items  = feedGrid.querySelectorAll<HTMLElement>('.feed-item');

        items.forEach((item) => {
          if (filter === 'all' || filter === 'contact') {
            item.style.display = '';
            return;
          }

          const kind = item.dataset.kind ?? '';
          const tags = (item.dataset.tags ?? '').split(',');

          const matchKind  = kind === filter;
          const matchTag   = tags.some((t) => t.includes(filter));
          const isContact  = kind === 'contact';

          item.style.display = (matchKind || matchTag || isContact) ? '' : 'none';
        });
      });
    });
  }
</script>
