---
// Blobs decorativos animados para el hero
---
<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
  <!-- Blob 1 — violet -->
  <div
    class="blob blob-1"
    style="
      width: 480px; height: 480px;
      background: var(--black-pearl);
      top: -120px; left: -80px;
      opacity: 0.12;
    "
  ></div>

  <!-- Blob 2 — periwinkle -->
  <div
    class="blob blob-2"
    style="
      width: 380px; height: 380px;
      background: #837ab6;
      top: 60px; right: -60px;
      opacity: 0.18;
    "
  ></div>

  <!-- Blob 3 — peony -->
  <div
    class="blob blob-3"
    style="
      width: 280px; height: 280px;
      background: #d183a9;
      bottom: -40px; left: 30%;
      opacity: 0.16;
    "
  ></div>

  <!-- Blob 4 — tea green -->
  <div
    class="blob"
    style="
      width: 200px; height: 200px;
      background: #d1efbd;
      top: 40%; right: 10%;
      opacity: 0.22;
      animation: blob-float-alt 18s ease-in-out infinite;
    "
  ></div>
</div>
