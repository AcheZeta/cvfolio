---
/**
 * HeroSection.astro
 * Hero de pantalla completa con nombre gigante, pill de roles,
 * cursor SVG flotante y flores decorativas.
 */
import Icon from '@/components/ui/Icon.astro';
---

<section class="hero" aria-label="Presentación">

  <!-- ─── Flores decorativas ──────────────────────── -->
  <div class="parallax-layer" data-speed="2" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--tl">
      <Icon name="flor" size={220} />
    </div>
  </div>
  <!-- Esquina sup der -->
  <div class="parallax-layer" data-speed="-3" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--tr">
      <Icon name="flor" size={180} />
    </div>
  </div>
  <!-- Esquina inf izq -->
  <div class="parallax-layer" data-speed="-1.5" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--bl">
      <Icon name="flor" size={160} />
    </div>
  </div>
  <!-- Esquina inf der -->
  <div class="parallax-layer" data-speed="2.5" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--br">
      <Icon name="flor" size={200} />
    </div>
  </div>
  <!-- Flores pequeñas dispersas -->
  <div class="parallax-layer" data-speed="4" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--sm1">
      <Icon name="flor" size={80} />
    </div>
  </div>
  <div class="parallax-layer" data-speed="-4" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--sm2">
      <Icon name="flor" size={64} />
    </div>
  </div>
  <div class="parallax-layer" data-speed="3" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1;">
    <div class="hero-flor hero-flor--sm3">
      <Icon name="flor" size={56} />
    </div>
  </div>

  <!-- ─── Contenido central ───────────────────────── -->
  <div class="hero-inner">

    <!-- Pill de roles -->
    <div class="hero-pill">
      Product Designer · UX Writer · Estratega
    </div>

    <!-- Nombre -->
    <div class="hero-name-wrap">
      <h1 class="hero-name">
        <span class="hero-name-line">Hame</span>
        <span class="hero-name-line">Elizalde</span>
      </h1>
    </div>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a href="/portafolio" class="hero-btn hero-btn--primary">
        Ver mi trabajo
        <Icon name="arrow-right" size={16} class="hero-btn-arrow" />
      </a>
      <a href="#contacto" class="hero-btn hero-btn--outline">
        Hablemos
      </a>
      
      <!-- Cursor SVG flotante -->
      <div class="hero-cursor" aria-hidden="true">
        <Icon name="cursor" size={80} />
      </div>
    </div>

  </div>
</section>
