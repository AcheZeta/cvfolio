---
/**
 * HeroSection.astro
 * Hero de pantalla completa con nombre gigante, pill de roles,
 * cursor SVG flotante y flores decorativas.
 */
import Icon from '@/components/ui/Icon.astro';
---

<section class="hero" aria-label="Presentación">

  <!-- ─── Flores decorativas ──────────────────────── -->
  <!-- Esquina sup izq -->
  <div class="hero-flor hero-flor--tl" aria-hidden="true">
    <Icon name="flor" size={220} />
  </div>
  <!-- Esquina sup der -->
  <div class="hero-flor hero-flor--tr" aria-hidden="true">
    <Icon name="flor" size={180} />
  </div>
  <!-- Esquina inf izq -->
  <div class="hero-flor hero-flor--bl" aria-hidden="true">
    <Icon name="flor" size={160} />
  </div>
  <!-- Esquina inf der -->
  <div class="hero-flor hero-flor--br" aria-hidden="true">
    <Icon name="flor" size={200} />
  </div>
  <!-- Flores pequeñas dispersas -->
  <div class="hero-flor hero-flor--sm1" aria-hidden="true">
    <Icon name="flor" size={80} />
  </div>
  <div class="hero-flor hero-flor--sm2" aria-hidden="true">
    <Icon name="flor" size={64} />
  </div>
  <div class="hero-flor hero-flor--sm3" aria-hidden="true">
    <Icon name="flor" size={56} />
  </div>

  <!-- ─── Contenido central ───────────────────────── -->
  <div class="hero-inner">

    <!-- Pill de roles -->
    <div class="hero-pill" role="text">
      Product Designer · UX Writer · Estratega
    </div>

    <!-- Nombre con cursor flotante -->
    <div class="hero-name-wrap">
      <h1 class="hero-name">
        <span class="hero-name-line">Hame</span>
        <span class="hero-name-line">Elizalde</span>
      </h1>
      <!-- Cursor SVG flotante -->
      <div class="hero-cursor" aria-hidden="true">
        <Icon name="cursor" size={80} />
      </div>
    </div>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a href="/portafolio" class="hero-btn hero-btn--primary">
        Ver mi trabajo
        <Icon name="arrow-right" size={16} class="hero-btn-arrow" />
      </a>
      <a href="#contacto" class="hero-btn hero-btn--outline">
        Hablemos
      </a>
    </div>

  </div>
</section>
