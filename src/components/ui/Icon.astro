  },
};

const icon = icons[name];
if (!icon)
  throw new Error(
    `Icon "${name}" not found. Check Icon.astro for available names.`,
  );

const viewBox = icon.viewBox ?? '0 0 24 24';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden={ariaHidden}
  aria-label={ariaLabel}
  class={className}
  set:html={icon.path}
/>
