---
interface Props {
  title?: string;
  caption?: string;
  type?: 'image' | 'video';
  src?: string;
  alt?: string;
  aspectRatio?: 'square' | 'landscape' | 'portrait';
  placeholderColor?: string;
}

const {
  title = '',
  caption = '',
  type = 'image',
  src,
  alt = title,
  aspectRatio = 'landscape',
  placeholderColor = '#3e3a5d',
} = Astro.props;

const aspectClasses: Record<string, string> = {
  square:    'aspect-square',
  landscape: 'aspect-video',
  portrait:  'aspect-[3/4]',
};
---

<div class="gallery-item group" tabindex="0">
  <!-- Placeholder or real image -->
  {src ? (
    <img
      src={src}
      alt={alt}
      class:list={['w-full h-full object-cover', aspectClasses[aspectRatio]]}
      loading="lazy"
    />
  ) : (
    <div
      class:list={['gallery-placeholder w-full flex items-center justify-center', aspectClasses[aspectRatio]]}
      style={`background: linear-gradient(135deg, ${placeholderColor}cc, ${placeholderColor}44);`}
      role="img"
      aria-label={alt || 'Imagen pendiente'}
    >
      <div class="text-center p-4">
        <span class="text-3xl opacity-40 block mb-2">
          {type === 'video' ? '▶' : '🖼'}
        </span>
        <p class="text-sm font-medium opacity-40" style="color: white;">
          {type === 'video' ? 'Video próximamente' : 'Imagen próximamente'}
        </p>
      </div>
    </div>
  )}

  <!-- Hover overlay -->
  <div class="gallery-overlay">
    <div class="flex flex-col gap-1 text-white">
      {title && (
        <p class="font-editorial text-lg leading-tight">{title}</p>
      )}
      {caption && (
        <p class="text-sm opacity-80">{caption}</p>
      )}
    </div>
  </div>
</div>
