---
import { getCollection } from 'astro:content';
import MasonryCard from '@/components/ui/MasonryCard.astro';

// Fetch all three collections
const projects = await getCollection('projects');
const posts = await getCollection('posts');
const talks = await getCollection('talks');

// Normalize all three into a unified shape
type FeedItem = {
  title: string;
  href: string;
  image?: any;
  date: Date;
  description?: string;
  category: 'proyecto' | 'blog' | 'charla';
};

const projectItems: FeedItem[] = projects.map((p) => ({
  title: p.data.title,
  href: `/projects/${p.id}`,
  image: p.data.image,
  date: p.data.date,
  description: p.data.description,
  category: 'proyecto',
}));

const postItems: FeedItem[] = posts.map((p) => ({
  title: p.data.title,
  href: `/writing/${p.id}`,
  image: p.data.image,
  date: p.data.date,
  description: p.data.seo?.description,
  category: 'blog',
}));

const talkItems: FeedItem[] = talks.map((t) => ({
  title: t.data.title,
  href: t.data.url || `/talks/${t.id}`,
  image: t.data.image,
  date: new Date(t.data.year, 0, 1),
  description: `${t.data.event} · ${t.data.location}`,
  category: 'charla',
}));

// Mix and sort by date descending
const feedItems: FeedItem[] = [
  ...projectItems,
  ...postItems,
  ...talkItems,
].sort((a, b) => b.date.getTime() - a.date.getTime());

interface Props {
  limit?: number;
  filter?: 'proyecto' | 'blog' | 'charla';
  hideHeader?: boolean;
}
const { limit, filter, hideHeader = false } = Astro.props;

// Filter items if needed
const filteredItems = filter 
  ? feedItems.filter(item => item.category === filter)
  : feedItems;

const displayItems = limit ? filteredItems.slice(0, limit) : filteredItems;
---

<section class="py-6">
  {
    !hideHeader && (
      <div class="flex flex-col gap-2 mb-8 reveal">
        <span
          class="text-xs font-medium uppercase tracking-widest"
          style="color: var(--soft-periwinkle);"
        >
          Proyectos, Charlas & Blog
        </span>
        <div class="flex items-end justify-between gap-4 flex-wrap">
          <h2 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
            Lo que he creado
          </h2>
          <a
            href="/projects"
            class="text-sm font-medium hover:text-[var(--soft-periwinkle)] transition-colors"
            style="color: var(--color-muted-foreground);"
          >
            Ver todo →
          </a>
        </div>
      </div>
    )
  }

  <!-- Masonry grid via CSS columns (defined in global.css) -->
  <div class="masonry-grid reveal reveal-delay-1">
    {
      displayItems.map((item) => (
        <MasonryCard
          title={item.title}
          href={item.href}
          image={item.image}
          date={item.date}
          description={item.description}
          category={item.category}
        />
      ))
    }
  </div>
</section>
