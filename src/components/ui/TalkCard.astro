---
interface Props {
  title: string;
  event?: string;
  type?: 'conferencia' | 'taller' | 'podcast' | 'panel' | 'charla' | 'otro';
  year?: string | number;
  location?: string;
  description?: string;
  href?: string;
  badge?: string;
}

const {
  title,
  event = '',
  type = 'charla',
  year = '',
  location = '',
  description = '',
  href,
  badge,
} = Astro.props;

const icons: Record<string, string> = {
  conferencia: '✦',
  taller: '✦',
  podcast: '✦',
  panel: '✦',
  charla: '✦',
};

const icon = icons[type] ?? '✦';

const typeColors: Record<string, string> = {
  conferencia: 'var(--muted-olive)',
  taller: 'var(--muted-olive)',
  podcast: 'var(--muted-olive)',
  panel: 'var(--muted-olive)',
  charla: 'var(--muted-olive)',
};

const color = typeColors[type] ?? typeColors.charla;
---

<article
  class:list={[
    'group relative flex gap-5 p-5 rounded-2xl border border-[var(--color-border)]',
    'bg-card hover:border-[var(--color-border-hover)]',
    'transition-all duration-300',
    href ? 'cursor-pointer' : '',
  ]}
>
  <!-- Icon badge -->
  <div
    class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center text-xl"
    style={`background-color: ${color}20; border: 1px solid ${color}40;`}
  >
    {icon}
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-1 flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <h3
        class="font-editorial text-lg leading-snug text-headings"
        class:list={[
          href
            ? 'group-hover:text-[var(--soft-periwinkle)] transition-colors'
            : '',
        ]}
      >
        {
          href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>

      {
        badge && (
          <span
            class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full"
            style="background-color: var(--muted-olive); color: var(--midnight-violet);"
          >
            {badge}
          </span>
        )
      }
    </div>

    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs"
      style="color: var(--color-muted-foreground);"
    >
      {event && <span>{event}</span>}
      {event && (year || location) && <span aria-hidden="true">·</span>}
      {year && <span>{year}</span>}
      {year && location && <span aria-hidden="true">·</span>}
      {location && <span>{location}</span>}
      <span
        class="capitalize rounded-full px-2 py-0.5 text-xs"
        style={`background-color: ${color}20; color: ${color};`}
      >
        {type}
      </span>
    </div>

    {
      description && (
        <p
          class="text-sm mt-1 leading-relaxed"
          style="color: var(--color-muted-foreground);"
        >
          {description}
        </p>
      )
    }
  </div>
</article>
