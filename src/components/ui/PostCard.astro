---
/**
 * PostCard.astro
 * Card estilo Tumblr para proyectos y entradas de blog.
 * Variantes de color por tipo, etiqueta flotante, tags internos y footer con acciones.
 */

export type CardVariant = 'lavender' | 'butter' | 'sage' | 'dark' | 'bubblegum';
export type CardKind = 'project' | 'blog' | 'contact';

interface Props {
  title: string;
  href?: string;
  description?: string;
  tags?: string[];
  role?: string;
  date?: Date;
  readingTime?: number;
  variant?: CardVariant;
  kind?: CardKind;
  floatingLabel?: string;
  class?: string;
}

const {
  title,
  href = '#',
  description,
  tags = [],
  role,
  date,
  readingTime,
  variant = 'lavender',
  kind = 'project',
  floatingLabel,
  class: extraClass = '',
} = Astro.props;

// Paleta de fondo según variante
const bgMap: Record<CardVariant, string> = {
  lavender:   'var(--color-lavender)',
  butter:     'var(--color-butter)',
  sage:       'var(--color-sage)',
  dark:       'var(--color-dark)',
  bubblegum:  'var(--color-bubblegum)',
};
const bgColor = bgMap[variant];

// Colores de texto según variante
const isLight = variant !== 'dark';
const textColor    = isLight ? 'var(--color-dark)'      : 'var(--color-bg)';
const mutedColor   = isLight ? 'rgba(26,15,46,0.55)'     : 'rgba(245,240,232,0.55)';
const borderColor  = isLight ? 'var(--color-dark)'      : 'rgba(245,240,232,0.25)';
const dividerColor = isLight ? 'rgba(26,15,46,0.15)'    : 'rgba(245,240,232,0.15)';

// Colores del tag flotante
const floatingBg   = variant === 'butter' ? 'var(--color-dark)' : 'var(--color-bg)';
const floatingText = variant === 'butter' ? 'var(--color-bg)'   : 'var(--color-dark)';

// Etiqueta flotante por defecto
const defaultLabel = kind === 'blog'
  ? `Blog${readingTime ? ` · ${readingTime} min` : ''}`
  : kind === 'contact'
    ? 'Trabajemos juntas ✦'
    : floatingLabel ?? 'Proyecto';

const labelText = floatingLabel ?? defaultLabel;
const labelIsLeft = kind === 'blog' || kind === 'contact';

// Paletas de colores para tags internos por variante
const tagBgMap: Record<CardVariant, string> = {
  lavender: 'var(--color-dark)',
  butter:   'var(--color-dark)',
  sage:     'var(--color-dark)',
  dark:     'var(--color-lavender)',
  bubblegum:'var(--color-dark)',
};
const tagTextMap: Record<CardVariant, string> = {
  lavender: 'var(--color-bg)',
  butter:   'var(--color-bg)',
  sage:     'var(--color-bg)',
  dark:     'var(--color-dark)',
  bubblegum:'var(--color-bg)',
};
const tagBg   = tagBgMap[variant];
const tagText = tagTextMap[variant];

// Formato de fecha
const formattedDate = date
  ? date.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;

// Borde dashed para blog
const borderStyle = kind === 'blog' ? 'dashed' : 'solid';
---

<a
  href={href}
  class:list={['post-card', `post-card--${variant}`, `post-card--${kind}`, extraClass]}
  style={`background:${bgColor}; color:${textColor}; border: 2px ${borderStyle} ${borderColor};`}
  data-kind={kind}
>
  <!-- ─── Etiqueta flotante ──────────────────────── -->
  <span
    class:list={['post-card__label', labelIsLeft ? 'post-card__label--left' : 'post-card__label--right']}
    style={`background:${floatingBg}; color:${floatingText}; border: 2px solid ${borderColor};`}
    aria-hidden="true"
  >
    {labelText}
  </span>

  <!-- ─── Cuerpo principal ──────────────────────── -->
  <div class="post-card__body">
    <h3 class="post-card__title" style={`color:${textColor};`}>{title}</h3>
    {description && <p class="post-card__desc" style={`color:${mutedColor};`}>{description}</p>}

    {tags.length > 0 && (
      <div class="post-card__tags" aria-label="Etiquetas">
        {tags.map((tag) => (
          <span
            class="post-card__tag"
            style={`background:${tagBg}; color:${tagText};`}
          >
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- ─── Footer de la card ──────────────────────── -->
  <div class="post-card__footer" style={`border-top: 1.5px solid ${dividerColor};`}>
    <div class="post-card__meta" style={`color:${mutedColor};`}>
      {formattedDate && <span>{formattedDate}</span>}
      {role && <span class="post-card__role">{role}</span>}
    </div>
    <div class="post-card__actions">
      <span class="post-card__icon" aria-label="Ver" title="Ver" style={`color:${mutedColor};`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </span>
    </div>
  </div>
</a>
