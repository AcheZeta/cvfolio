---
interface Props {
  label: string;
  variant?: 'default' | 'highlight';
}

const { label, variant = 'default' } = Astro.props;
---

<span
  class:list={[
    // base
    'px-6 py-2 rounded-full border text-sm font-medium transition-colors',
    'select-none cursor-default',

    // default
    variant === 'default' &&
      'border-border bg-muted text-headings hover:border-[var(--color-border-hover)]',

    // highlight (misma lógica, distinto surface)
    variant === 'highlight' &&
      'border-border bg-[var(--color-surface)] text-headings hover:border-[var(--color-border-hover)]'
  ]}
>
  {label}
</span>
