<!-- src/components/ui/TalksSection.astro -->
---
import TalkCard from '@/components/ui/TalkCard.astro';
export interface Props {
  talksCollection: any[]; // CollectionEntry<'talks'>[]
}
const { talksCollection } = Astro.props;
---
<div class="flex flex-col gap-10">
  <div class="flex flex-col gap-2 reveal">
    <span class="text-xs font-medium uppercase tracking-widest" style="color: var(--sweet-peony);">Charlas & Presentaciones</span>
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <h2 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">Donde comparto ideas</h2>
      {talksCollection.length > 0 && (
        <a href="/talks" class="text-sm font-medium hover:text-[var(--soft-periwinkle)] transition-colors" style="color: var(--color-muted-foreground);">
          Ver todas →
        </a>
      )}
    </div>
  </div>

  <div class="flex flex-col gap-4 reveal reveal-delay-1">
    {talksCollection.length > 0 ? (
      talksCollection.slice(0, 5).map((talk) => (
        <TalkCard
          title={talk.data.title}
          event={talk.data.event}
          type="conferencia"
          year={String(talk.data.year)}
          location={talk.data.location}
          href={talk.data.url}
        />
      ))
    ) : (
      <>
        <TalkCard
          title="Diseño Inclusivo en la Era de la IA"
          event="Women in Tech México"
          type="conferencia"
          year="2024"
          location="Ciudad de México"
          badge="Keynote"
          description="Cómo integrar principios de accesibilidad y perspectiva de género en el diseño de productos impulsados por IA."
        />
        <TalkCard
          title="UX Writing para Productos con Impacto Social"
          event="UX+EDU Summit"
          type="taller"
          year="2024"
          location="Online"
          description="Taller práctico sobre cómo construir voz de marca inclusiva y microcopy que realmente conecte."
        />
        <TalkCard
          title="Feminismo y Tecnología: diseñando para todas"
          event="Podcast Mujeres Tech"
          type="podcast"
          year="2023"
          badge="Episodio destacado"
          description="Conversación sobre interseccionalidad, sesgos en diseño y cómo crear productos más equitativos."
        />
        <TalkCard
          title="EdTech con Perspectiva: aprendizaje para cada persona"
          event="Campus Party México"
          type="panel"
          year="2023"
          location="Ciudad de México"
          description="Panel sobre el futuro de la educación digital y el rol del diseño inclusivo en plataformas de aprendizaje."
        />
        <TalkCard
          title="Diseño de Contenido: la voz importa"
          event="Interaction Design Foundation — Capítulo MX"
          type="conferencia"
          year="2022"
          location="Guadalajara"
          description="Por qué el content design es estratégico y cómo medirlo."
        />
      </>
    )}
  </div>
</div>
