---
import TalkCard from '@/components/ui/TalkCard.astro';
export interface Props {
  talksCollection: any[]; // CollectionEntry<'talks'>[]
}
const { talksCollection } = Astro.props;
---

<!-- src/components/ui/TalksSection.astro -->
<div class="flex flex-col gap-10">
  <div class="flex flex-col gap-2 reveal">
    <span
      class="text-xs font-medium uppercase tracking-widest"
      style="color: var(--sweet-peony);">Charlas & Presentaciones</span
    >
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <h2
        class="font-editorial text-4xl md:text-5xl font-semibold text-headings"
      >
        Donde comparto ideas
      </h2>
      {
        talksCollection.length > 0 && (
          <a
            href="/talks"
            class="text-sm font-medium hover:text-[var(--soft-periwinkle)] transition-colors"
            style="color: var(--color-muted-foreground);"
          >
            Ver más →
          </a>
        )
      }
    </div>
  </div>

  <div class="flex flex-col gap-4 reveal reveal-delay-1">
    {
      talksCollection.length > 0 ? (
        talksCollection
          .slice(0, 5)
          .map((talk) => (
            <TalkCard
              title={talk.data.title}
              event={talk.data.event}
              type={talk.data.type}
              year={String(talk.data.year)}
              location={talk.data.location}
              href={talk.data.url}
            />
          ))
      ) : (
        <></>
      )
    }
  </div>
</div>
