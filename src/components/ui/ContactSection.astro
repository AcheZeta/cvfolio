---
import { getCollection } from 'astro:content';
import Container from '@/components/Container.astro';

interface Props {
  email?: string;
}

const { email = '' } = Astro.props;

const links = await getCollection('links');
---

<!-- Email CTA -->{
  email && (
    <a
      href={`mailto:${email}`}
      class="group inline-flex items-center gap-4 w-fit"
    >
      <span
        class="font-editorial text-3xl md:text-4xl leading-none text-headings
               group-hover:text-[var(--soft-periwinkle)] transition-colors duration-300"
      >
        {email}
      </span>
      <span
        class="text-2xl transition-transform duration-300 group-hover:translate-x-2"
        style="color: var(--soft-periwinkle);"
      >
        →
      </span>
    </a>
  )
}

<!-- Social links -->
{
  links.length > 0 && (
    <Container as="section" class="py-10">
      <div class="flex flex-col gap-4">
        <p class="text-sm uppercase tracking-wide">Contacto</p>
        <ul class="flex flex-wrap gap-3">
          {links.map((link) => (
            <li>
              <a
                href={link.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-[var(--color-border)] text-sm font-medium text-headings hover:border-[var(--soft-periwinkle)] hover:bg-[var(--soft-periwinkle)] hover:text-white transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--soft-periwinkle)]"
              >
                {link.data.label || link.data.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  )
}
