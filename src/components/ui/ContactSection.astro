---
/**
 * ContactSection.astro
 * Sección de contacto con heading enorme, social pills y CTA de email.
 */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  email?: string;
}

const { email = 'hame.elizalde@gmail.com' } = Astro.props;

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/AcheZeta',
    icon: 'github' as const,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/ache_zeta/',
    icon: 'instagram' as const,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/hame-elizalde/',
    icon: 'linkedin' as const,
  },
  {
    label: 'Email',
    href: `mailto:${email}`,
    icon: 'email' as const,
  },
];
---

<section id="contacto" class="contact-section">
  <!-- ─── Fondo con noise sutil ────────────────── -->
  <div class="contact-bg" aria-hidden="true"></div>

  <div class="contact-inner">

    <!-- ─── Heading ─────────────────────────────── -->
    <div class="contact-heading-wrap">
      <h2 class="contact-heading">
        <span class="contact-heading-black">Trabajemos</span>
        <br />
        <span class="contact-heading-orange">juntas.</span>
        <!-- Cursor decorativo SVG -->
        <Icon
          name="cursor"
          size={56}
          class="contact-cursor"
          aria-hidden={true}
        />
      </h2>
      <p class="contact-subtitle">
        ¿Tienes un proyecto en mente? Me encantará escucharte.
      </p>
    </div>

    <!-- ─── Social pills grid ────────────────────── -->
    <ul class="contact-pills" role="list">
      {socials.map(({ label, href, icon }) => (
        <li>
          <a
            href={href}
            target={href.startsWith('mailto') ? undefined : '_blank'}
            rel="noopener noreferrer"
            class="contact-pill"
          >
            <span class="contact-pill-icon">
              <Icon name={icon} size={18} />
            </span>
            <span class="contact-pill-label">{label}</span>
            <span class="contact-pill-arrow" aria-hidden="true">
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <!-- ─── CTA principal ────────────────────────── -->
    <div class="contact-cta-wrap">
      <a href={`mailto:${email}`} class="contact-cta">
        Envíame un mensaje
        <Icon name="arrow-right" size={16} class="contact-cta-arrow" />
      </a>
    </div>

  </div>
</section>
