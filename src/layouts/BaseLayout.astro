---
import '@/styles/global.css';
import '@/assets/fonts/inter.css';
import '@/assets/fonts/neulis.css';
import '@/assets/fonts/poppins.css';
import { type Seo } from '@/lib/constants';
import Head from '@/components/partials/Head.astro';
import Sidebar from '@/components/partials/Sidebar.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  seo?: Seo;
  fullBleed?: boolean;
}

const { seo, fullBleed = false } = Astro.props;
---

<html lang="es">
  <Head seo={seo}>
    <ViewTransitions />
  </Head>
  <body class="tumblr-body">
    <div class="app-shell">
      <Sidebar />
      <main class="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
