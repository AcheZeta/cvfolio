---
import Container from '@/components/Container.astro';
import Avatar from '@/components/ui/Avatar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projects');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout seo={entry.data.seo}>
  <Container as="section">
    <article class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <a
          href="/portafolio"
          class="transition-all hover:text-foreground pb-4 text-sm w-max"
        >
          Back to projects
        </a>
        <div class="flex flex-col gap-1.5">
          <Avatar />
          <span class="text-foreground"
            >{DEFAULT_CONFIGURATION.author.name}</span
          >
        </div>
        <h1 class="text-3xl font-semibold text-headings">{entry.data.title}</h1>
      </div>
      {
        entry.data.image && (
          <div class="relative aspect-video overflow-hidden rounded-lg">
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              class="object-cover"
            />
          </div>
        )
      }
      <div class="prose dark:prose-invert">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const initLightbox = () => {
    // Select all images within the article
    const images = document.querySelectorAll<HTMLImageElement>('article img');
    
    if (images.length === 0) return;

    let lightbox: PhotoSwipeLightbox | null = null;

    images.forEach((img, index) => {
      // Add zoom-in cursor to indicate it's clickable
      img.style.cursor = 'zoom-in';
      
      img.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (!lightbox) {
          lightbox = new PhotoSwipeLightbox({
            // Generate the data source on click so that naturalWidth/Height are loaded
            dataSource: Array.from(images).map((i) => ({
              src: i.src,
              width: i.naturalWidth || 1200,
              height: i.naturalHeight || 800,
              alt: i.alt
            })),
            pswpModule: () => import('photoswipe'),
            padding: { top: 20, bottom: 20, left: 20, right: 20 },
            wheelToZoom: true,
            bgOpacity: 0.9,
          });
          lightbox.init();
        }
        
        lightbox.loadAndOpen(index);
      });
    });
  };

  initLightbox();
</script>
