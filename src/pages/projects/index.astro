---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MasonryGrid from '@/components/ui/MasonryGrid.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const { name } = DEFAULT_CONFIGURATION.author;
const seo = {
  title: `Proyectos — ${name}`,
  description: 'Una selección de mis proyectos más recientes y destacados.',
};
---

<BaseLayout seo={seo}>
  <Container as="section" class="pb-12">
    <div class="flex flex-col gap-2 mb-8 reveal">
      <span
        class="text-xs font-medium uppercase tracking-widest"
        style="color: var(--soft-periwinkle);"
      >
        Portfolio
      </span>
      <h1
        class="font-editorial text-4xl md:text-5xl font-semibold text-headings"
      >
        Mis Proyectos
      </h1>
      <p
        class="text-lg max-w-2xl"
        style="color: var(--color-muted-foreground);"
      >
        Aquí puedes explorar el trabajo en el que he estado enfocada
        últimamente.
      </p>
    </div>

    <!-- Masonry grid filtered to show only projects -->
    <MasonryGrid filter="proyecto" hideHeader={true} />
  </Container>
</BaseLayout>
