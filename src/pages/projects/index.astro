---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const { name } = DEFAULT_CONFIGURATION.author;
const seo = {
  title: `Proyectos — ${name}`,
  description: 'Una selección de mis proyectos más recientes y destacados.',
};

const projects = await getCollection('projects');
const sorted = projects.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout seo={seo}>
  <Container as="section" class="pb-12">
    <div class="flex flex-col gap-2 mb-10 reveal">
      <span class="text-xs font-medium uppercase tracking-widest" style="color: var(--soft-periwinkle);">
        Portfolio
      </span>
      <h1 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
        Mis Proyectos
      </h1>
      <p class="text-lg max-w-2xl" style="color: var(--color-muted-foreground);">
        Aquí puedes explorar el trabajo en el que he estado enfocada últimamente.
      </p>
    </div>

    <ul class="flex flex-col gap-6">
      {sorted.map((project) => (
        <li>
          
            href={`/projects/${project.id}`}
            class="group flex flex-col sm:flex-row gap-5 rounded-2xl border border-[var(--color-border)] p-5 transition-all duration-200 hover:border-[var(--color-border-hover)] hover:shadow-md"
          >
            {project.data.image && (
              <div class="shrink-0 w-full sm:w-44 h-32 overflow-hidden rounded-xl bg-[var(--brand-surface)]">
                <Image
                  src={project.data.image}
                  alt={project.data.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            )}
            <div class="flex flex-col gap-2 justify-center">
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {project.data.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)]" style="color: var(--color-muted-foreground);">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <h2 class="text-lg font-semibold text-headings leading-snug">
                {project.data.title}
              </h2>
              {project.data.description && (
                <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-muted-foreground);">
                  {project.data.description}
                </p>
              )}
              <div class="flex items-center gap-3 text-xs mt-1" style="color: var(--color-muted-foreground);">
                {project.data.role && <span>{project.data.role}</span>}
                <span>
                  {new Date(project.data.date).toLocaleDateString('es-MX', { month: 'long', year: 'numeric' })}
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>