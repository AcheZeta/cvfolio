---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MasonryGrid from '@/components/ui/MasonryGrid.astro';

// Obtener datos de SEO de la página homepage
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
---

<BaseLayout seo={homeEntry.data.seo}>
  <MasonryGrid />
</BaseLayout>
