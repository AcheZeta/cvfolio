---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Author from '@/components/ui/Author.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import TalksSection from '@/components/ui/TalksSection.astro';
import { sortJobsByDate } from '@/lib/utils';
import Chip from '@/components/ui/Chip.astro';
import { getSiteConfig } from '@/lib/config';
import Marquee from '@/components/ui/Marquee.astro';
import MasonryGrid from '@/components/ui/MasonryGrid.astro';

// Obtener datos
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
const entry = homeEntry;
const links = await getCollection('links');
const talksCollection = await getCollection('talks');
const { Content } = await render(entry);
const aboutEntry = await getEntry('pages', 'about');
const allPages = await getCollection('pages');
const pages = allPages.filter(
  (page) => !['homepage', 'experience'].includes(page.id),
);

const config = getSiteConfig();
---

<BaseLayout seo={entry.data.seo}>
  <Container as="section" class="py-6">
    <Author {...DEFAULT_CONFIGURATION.author} />
    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-3 mt-8 reveal reveal-delay-3">
      <a
        href="/portafolio"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm
               transition-all duration-200 hover:scale-105 hover:shadow-lg focus-visible:outline-none
               focus-visible:ring-2 focus-visible:ring-[var(--soft-periwinkle)]"
        style="background-color: var(--muted-olive); color: var(--black-pearl);"
      >
        Portafolio
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-sm
               border border-[var(--color-border)] text-headings
               transition-all duration-200 hover:border-[var(--soft-periwinkle)]
               hover:bg-[var(--soft-periwinkle)] hover:text-white
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--soft-periwinkle)]"
      >
        Hablemos
      </a>
    </div>
  </Container>
  <!-- ════════════════ MARQUEE — Skills ═══════════════════ -->
  <div class="my-10">
    <Marquee speed="normal" />
  </div>
  <Container as="section" class="py-6">
    <div class="flex flex-col gap-6">
      <div class="flex items-center">
        <p class="text-sm uppercase tracking-wide">Sobre mí</p>
      </div>
      <div class="prose dark:prose-invert">
        <Content />
      </div>
    </div>
  </Container>

  <!-- ════════════════ PROYECTOS & BLOG — Masonry ════════════════ -->
  <Container as="section" class="py-6">
    <MasonryGrid limit={3} />
  </Container>

  <!-- CONTACTO -->
  {
    links.length > 0 && (
      <Container as="section" class="py-10">
        <div class="flex flex-col gap-4">
          <p class="text-sm uppercase tracking-wide">Contacto</p>
          <ul class="flex flex-wrap gap-3">
            {links.map((link) => (
              <li key={link.id}>
                <a
                  href={link.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-[var(--color-border)] text-sm font-medium text-headings hover:border-[var(--soft-periwinkle)] hover:bg-[var(--soft-periwinkle)] hover:text-white transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--soft-periwinkle)]"
                >
                  {link.data.label || link.data.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    )
  }
</BaseLayout>
