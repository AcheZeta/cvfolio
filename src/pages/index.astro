---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedSection from '@/components/ui/FeedSection.astro';

// Obtener datos de SEO de la página homepage
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
---

<BaseLayout seo={homeEntry.data.seo}>
  <!-- ─── Cabecera del feed ──────────────────────── -->
  <div class="feed-header">
    <h2 class="feed-title">Feed</h2>
    <p class="feed-subtitle">Proyectos y artículos · en orden cronológico</p>
  </div>

  <!-- ─── Feed principal ───────────────────────── -->
  <FeedSection />
</BaseLayout>

