---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedGrid from '@/components/ui/FeedGrid.astro';

// Obtener datos de SEO de la página homepage
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
---

<BaseLayout seo={homeEntry.data.seo}>
  <!-- ─── Cabecera del feed ──────────────────────── -->
  <div class="feed-header">
    <h2 class="feed-title">Proyectos</h2>
    <p class="feed-subtitle">Explora mis proyectos y artículos <3</p>
  </div>

  <!-- ─── Feed principal ───────────────────────── -->
  <FeedGrid />
</BaseLayout>
