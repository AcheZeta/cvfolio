---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import Marquee from '@/components/ui/Marquee.astro';
import ProjectsSection from '@/components/ui/ProjectsSection.astro';
import ContactSection from '@/components/ui/ContactSection.astro';
import HeroSection from '@/components/ui/HeroSection.astro';
import AboutSection from '@/components/ui/AboutSection.astro';
import Container from '@/components/Container.astro';

// Obtener datos
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
const entry = homeEntry;
const { Content } = await render(entry);
---

<BaseLayout seo={entry.data.seo} fullBleed={true}>
  <!-- ════════════════ HERO ════════════════ -->
  <HeroSection />

  <!-- ════════════════ MARQUEE — Skills ════════════════ -->
  <div class="my-10">
    <Marquee speed="normal" />
  </div>

  <!-- ════════════════ SOBRE MÍ ════════════════ -->
  <AboutSection />

  <!-- ════════════════ BLOG ════════════════ -->
  <ProjectsSection limit={4} />

  <!-- ════════════════ CONTACTO ════════════════ -->
  <ContactSection email={DEFAULT_CONFIGURATION.author.email} />
</BaseLayout>
