---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Author from '@/components/ui/Author.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import Talk from '@/components/ui/Talk.astro';
import { sortJobsByDate } from '@/lib/utils';

// Obtener datos
const homeEntry = await getEntry('pages', 'homepage');
if (!homeEntry) {
  throw new Error('No se encontró la página homepage');
}
const entry = homeEntry;
const { Content } = await render(entry);
const aboutEntry = await getEntry('pages', 'about');
const allPages = await getCollection('pages');
const pages = allPages.filter(
  (page) => !['homepage', 'experience'].includes(page.id),
);
---

<BaseLayout seo={entry.data.seo}>
  <Container as="section" class="py-6">
    <Author {...DEFAULT_CONFIGURATION.author} />
  </Container>

  <!-- LO QUE HAGO -->
  <Container as="section" class="py-10">
    <div class="flex flex-col gap-4">
      <p class="text-sm uppercase tracking-wide text-muted-foreground">
        Lo que hago
      </p>

      <div class="flex flex-wrap gap-4">
        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Producto & UX
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Frontend
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          UX Writing
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Estrategia digital
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Optimización de procesos
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Service Design & experiencia de cliente
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Contenido
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Diseño de producto
        </span>

        <span
          class="px-6 py-2 rounded-full border border-border bg-muted text-headings text-sm font-medium
                   hover:border-amber-300 transition
                   select-none cursor-default"
        >
          Marketing digital
        </span>
      </div>
    </div>
  </Container>

  <!-- Bento  -->
  <Container as="section" class="py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        pages
          .filter((page) => !['about', 'projects'].includes(page.id))
          .map((page) => (
            <a
              href={`/${page.id}`}
              class="group relative overflow-hidden rounded-lg border border-border bg-card p-6 hover:border-amber-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2"
            >
              <div class="flex flex-col h-full">
                <h2 class="text-lg font-semibold text-headings group-hover:text-foreground transition-colors">
                  {page.data.title}
                </h2>
                <p class="text-sm mt-2">{page.data.seo.description}</p>
                <div class="mt-auto pt-4">
                  <span class="text-xs group-hover:text-foreground/70 transition-colors">
                    Explorar →
                  </span>
                </div>
              </div>
            </a>
          ))
      }
    </div>
  </Container>
</BaseLayout>
