---
import { getEntry, render } from 'astro:content';
import Author from '@/components/ui/Author.astro';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const servicesEntry = await getEntry('pages', 'services');
if (!servicesEntry) {
  throw new Error('No se encontró la página services');
}
const entry = servicesEntry;
const { Content } = await render(entry);
---

<BaseLayout seo={entry.data.seo}>
  <Author {...DEFAULT_CONFIGURATION.author} />
  <article class="flex flex-col gap-6">
    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
