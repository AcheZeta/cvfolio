---
import { getEntry } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MasonryGrid from '@/components/ui/MasonryGrid.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const writingEntry = await getEntry('pages', 'writing');
if (!writingEntry) {
  throw new Error('No se encontró la página writing');
}
const entry = writingEntry;
---

<BaseLayout seo={entry.data.seo}>
  <Container as="section" class="pb-12">
    <div class="flex flex-col gap-2 mb-8 reveal">
      <span
        class="text-xs font-medium uppercase tracking-widest"
        style="color: var(--soft-periwinkle);"
      >
        Blog
      </span>
      <h1
        class="font-editorial text-4xl md:text-5xl font-semibold text-headings"
      >
        Lo que estoy escribiendo
      </h1>
      <p
        class="text-lg max-w-2xl"
        style="color: var(--color-muted-foreground);"
      >
        Reflexiones y aprendizajes sobre diseño, accesibilidad y desarrollo.
      </p>
    </div>

    <!-- Masonry grid filtered to show only blog posts -->
    <MasonryGrid filter="blog" hideHeader={true} />
  </Container>
</BaseLayout>
