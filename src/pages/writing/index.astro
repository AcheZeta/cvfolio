---
import { getEntry } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedGrid from '@/components/ui/FeedGrid.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const writingEntry = await getEntry('pages', 'writing');
if (!writingEntry) {
  throw new Error('No se encontró esta página');
}
const entry = writingEntry;
---

<BaseLayout seo={entry.data.seo}>
  <div class="flex flex-col gap-2 mb-8 reveal">
    <h1 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
      Mi Blog
    </h1>
    <p class="text-lg max-w-2xl" style="color: var(--color-muted-foreground);">
      Reflexiones y aprendizajes sobre diseño, accesibilidad y desarrollo.
    </p>
  </div>

  <!-- Masonry grid filtered to show only blog posts -->
  <FeedGrid filter="blog" hideHeader={true} />
</BaseLayout>
