---
import { getCollection, getEntry, render } from 'astro:content';
import Author from '@/components/ui/Author.astro';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import Talk from '@/components/ui/Talk.astro';
import ProjectPreview from '@/components/ui/ProjectPreview.astro';
import PostPreview from '@/components/ui/PostPreview.astro';
import { sortJobsByDate } from '@/lib/utils';
import { sortTalksByDate } from '@/lib/utils';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error('No se encontró la página about');
}
const entry = aboutEntry;
const { Content } = await render(entry);

// Obtener datos dinámicos
const jobs = await getCollection('jobs');
const sortedJobs = sortJobsByDate(jobs);
const projects = await getCollection('projects');
const posts = await getCollection('posts');
const talks = await getCollection('talks');
const sortedTalks = sortTalksByDate(talks);
---

<BaseLayout seo={entry.data.seo}>
  <Container as="section" class="py-6">
    <Author {...DEFAULT_CONFIGURATION.author} />
  </Container>

  <!-- About Content -->
  {Content && (
    <Container as="section" class="py-6">
      <article class="flex flex-col gap-6">
        <div class="flex items-center">
          <span class="text-headings">Sobre mí</span>
        </div>
        <div class="prose dark:prose-invert max-w-none">
          <Content />
        </div>
      </article>
    </Container>
  )}

  <!-- Experiencia -->
  {sortedJobs.length > 0 && (
    <Container as="section" class="py-6">
      <div class="flex flex-col gap-5">
        <span class="text-headings">Experiencia Profesional</span>
        <ul class="flex flex-col gap-8">
          {sortedJobs.map((job) => (
            <WorkExperience entry={job} />
          ))}
        </ul>
      </div>
    </Container>
  )}


  <!-- Charlas -->
{talks.length > 0 && (
      <Container as="section" class="py-6">
        <div class="flex flex-col gap-5">
          <span class="text-headings">Charlas</span>
          <ul class="flex flex-col gap-8">
            {sortedTalks.map((talk) => (
              <Talk entry={talk} />
            ))}
          </ul>
        </div>
      </Container>
    )
  } 
</BaseLayout>
