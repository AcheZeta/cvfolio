---
import { getCollection, getEntry, render } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import { sortJobsByDate } from '@/lib/utils';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error('No se encontró la página about');
}
const entry = aboutEntry;
const { Content } = await render(entry);

// Obtener datos dinámicos
const jobs = await getCollection('jobs');
const sortedJobs = sortJobsByDate(jobs);
---

<BaseLayout seo={entry.data.seo}>
  <!-- About Content -->
  {
    Content && (
      <article class="flex flex-col gap-6">
        <div class="flex items-center">
          <h1 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
            Quién soy
          </h1>
        </div>
        <div class="prose dark:prose-invert max-w-none">
          <Content />
        </div>
      </article>
    )
  }

  <!-- Experiencia -->
  {
    sortedJobs.length > 0 && (
      <div class="flex flex-col gap-5">
        <span class="text-headings">Experiencia Profesional</span>
        <ul class="flex flex-col gap-8">
          {sortedJobs.map((job) => (
            <WorkExperience entry={job} />
          ))}
        </ul>
      </div>
    )
  }
</BaseLayout>
