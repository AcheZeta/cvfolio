---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import FeedGrid from '@/components/ui/FeedGrid.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const { name } = DEFAULT_CONFIGURATION.author;

const seo = {
  title: `Fotografía — ${name}`,
  description:
    'Portafolio fotográfico — series, retratos y exploración visual.',
};
---

<BaseLayout seo={seo}>
  <div class="flex flex-col gap-2 mb-10 reveal">
    <span
      class="text-xs font-medium uppercase tracking-widest"
      style="color: var(--soft-periwinkle);"
    >
      Portafolio visual
    </span>
    <h1 class="font-editorial text-4xl md:text-5xl font-semibold text-headings">
      Fotografía
    </h1>
    <p class="text-base text-[var(--color-muted-foreground)] max-w-prose">
      Series fotográficas, exploraciones visuales y momentos capturados.
    </p>
  </div>

  <FeedGrid filter="foto" hideHeader />
</BaseLayout>
