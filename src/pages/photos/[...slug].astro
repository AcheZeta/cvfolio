---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

export async function getStaticPaths() {
  const entries = await getCollection('photos');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  cover,
  gallery = [],
  description,
  location,
  camera,
  date,
  tags,
  seo,
} = entry.data;

const formattedDate = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const allImages = [cover, ...gallery];
---

<BaseLayout seo={{ ...seo, image: cover }}>
  <article class="photo-article flex flex-col gap-8">
    <!-- Back link -->
    <a
      href="/photos"
      class="transition-all hover:text-foreground text-sm w-max"
    >
      ← Volver a fotografía
    </a>

    <!-- Header -->
    <header class="flex flex-col gap-3">
      <div class="flex flex-wrap gap-2">
        {
          tags?.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted-foreground)]">
              #{tag}
            </span>
          ))
        }
      </div>
      <h1 class="text-3xl font-semibold text-headings">{title}</h1>
      <div
        class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-muted-foreground)]"
      >
        {location && <span>📍 {location}</span>}
        {camera && <span>📷 {camera}</span>}
        <span>{formattedDate}</span>
      </div>
      {description && <p class="text-base leading-relaxed">{description}</p>}
    </header>

    <!-- Cover image (clickable → lightbox) -->
    <div class="pswp-gallery rounded-2xl overflow-hidden" id="photo-gallery">
      <!-- Cover always shown as hero -->
      <a
        href={cover.src}
        data-pswp-width={cover.width}
        data-pswp-height={cover.height}
        class="block"
        aria-label={`Ver ${title} en tamaño completo`}
      >
        <Image
          src={cover}
          alt={title}
          class="w-full object-cover rounded-2xl cursor-zoom-in transition-transform duration-300 hover:scale-[1.01]"
        />
      </a>

      <!-- Gallery grid (si hay fotos adicionales) -->
      {
        gallery.length > 0 && (
          <div class="photo-gallery-grid mt-4">
            {gallery.map((img, i) => (
              <a
                href={img.src}
                data-pswp-width={img.width}
                data-pswp-height={img.height}
                aria-label={`Foto ${i + 2} de la serie`}
              >
                <Image
                  src={img}
                  alt={`${title} — foto ${i + 2}`}
                  class="w-full h-full object-cover rounded-xl cursor-zoom-in transition-transform duration-300 hover:scale-[1.02]"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Prose content (historia detrás de la serie) -->
    {
      Content && (
        <div class="prose max-w-prose">
          <Content />
        </div>
      )
    }

    <!-- Author footer -->
    <footer
      class="pt-4 border-t border-[var(--color-border)] text-sm text-[var(--color-muted-foreground)]"
    >
      <span>Por {DEFAULT_CONFIGURATION.author.name}</span>
    </footer>
  </article>
</BaseLayout>

<style>
  .photo-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }

  .photo-gallery-grid a {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.75rem;
    display: block;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const initLightbox = () => {
    const gallery = document.getElementById('photo-gallery');
    if (!gallery) return;

    const lightbox = new PhotoSwipeLightbox({
      gallery: '#photo-gallery',
      children: 'a[data-pswp-width]',
      pswpModule: () => import('photoswipe'),
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      wheelToZoom: true,
      bgOpacity: 0.95,
    });

    lightbox.init();
  };

  initLightbox();
  document.addEventListener('astro:after-swap', initLightbox);
</script>
