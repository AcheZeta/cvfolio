---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedGrid from '@/components/ui/FeedGrid.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';

const { name } = DEFAULT_CONFIGURATION.author;
const seo = {
  title: `Portafolio — ${name}`,
  description: 'Colección de mis proyectos, artículos de blog y charlas.',
};
---

<BaseLayout seo={seo}>
  <!-- Masonry grid sin filtro ni límite para mostrar TODO -->
  <FeedGrid hideHeader={false} showFilter={false} />
</BaseLayout>
